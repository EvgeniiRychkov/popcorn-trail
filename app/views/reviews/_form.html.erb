<%= link_to '← Back', movie_path(@movie), class: 'btn btn-secondary mb-3' %>

<div class="d-flex align-items-center justify-content-center">
  <div class="card shadow-sm p-4" style="min-width: 350px; max-width: 500px; width: 100%;">
    <h2 class="text-center mb-4">
      <%= review.new_record? ? "Leave a Review" : "Edit Review" %>
    </h2>

    <%= form_with(model: [@movie, review], local: true) do |f| %>
      <% if review.errors.any? %>
        <div class="alert alert-danger">
          <p><strong><%= pluralize(review.errors.count, "error") %> prohibited this review from being saved:</strong></p>
          <ul>
            <% review.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :rating, class: "form-label" %>
        <%= f.select :rating, (1..10).to_a, {}, class: "form-select" %>
      </div>

      <div class="mb-3">
        <%= f.label :text, "Your Review", class: "form-label" %>
        <%= f.text_area :text, class: "form-control", rows: 5 %>
      </div>

      <div class="d-grid">
        <%= f.submit review.new_record? ? "Submit Review" : "Update Review", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
